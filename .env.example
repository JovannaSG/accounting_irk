# Скопируйте в .env в КОРНЕ проекта и заполните значения.
# Файл подхватывается автоматически при запуске (app/run.py или
# streamlit run app/ui.py); уже заданные переменные окружения имеют
# приоритет над .env.
# Подключение к 1С:Фреш по OData (см. README, раздел «Подключение к 1С:Фреш»).
# Если не заданы — используются значения ниже (публичная демо-база).
ONEC_URL=https://msk1.1cfresh.com/a/ea/3418453
ONEC_USER=odata.user
ONEC_PASS=

# Путь к файлу истории аудитов SQLite (по умолчанию ./audit_history.db)
AUDIT_DB_PATH=audit_history.db

# Ограничение доступа (ТЗ §11). Формат: «логин:хэш,логин2:хэш2».
# Если не задан — вход в приложении отключен (работает как раньше).
# Хэш генерируется утилитой:
#   python -m core.auth hash пароль
# AUDIT_USERS=auditor:200000$<соль-hex>$<хэш-hex>,reviewer:200000$<соль>$<хэш>
